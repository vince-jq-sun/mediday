# Google Cloud 配置
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# LLM 翻译配置 (选择一个或多个)
# Google Gemini (推荐用于翻译)
GOOGLE_AI_API_KEY=your-gemini-api-key

# OpenAI (可选)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude (可选)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 本地 LLM (可选，如 Ollama)
LOCAL_LLM_URL=http://localhost:11434

# 翻译设置
TRANSLATION_PROVIDER=gemini  # 选项: google, gemini, openai, anthropic, local
TRANSLATION_MODEL=gemini-2.0-flash-exp  # 最新最快模型
# 其他选项:
# gemini-2.0-flash-exp - 最新实验版本，速度最快
# gemini-1.5-pro - 稳定高质量版本
# gemini-1.5-flash - 平衡速度和质量

# 可选：指定输出目录
OUTPUT_DIR=./output
TEMP_DIR=./temp
